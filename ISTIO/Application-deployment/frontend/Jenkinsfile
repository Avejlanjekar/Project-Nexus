
pipeline{
    agent any

    environment{
        AWS_CREDENTIALS     = 'aws-ecr-credentials'
        BUILD_CONTEXT       = './frontend'
        FRONTEND_IMAGE_DEV  = 'avejlanjekar45/employee-management-frontend-dev'
        FRONTEND_IMAGE_QA   = 'avejlanjekar45/employee-management-frontend-qa'
        FRONTEND_IMAGE_UAT  = 'avejlanjekar45/employee-management-frontend-uat'
        FRONTEND_IMAGE_PROD = 'avejlanjekar45/employee-management-frontend-prod'
        REGISTRY_URL        = 'https://registry.hub.docker.com'
        DEV_DH_CREDENTIALS  = 'dockerhub-credentials'
        QA_DH_CREDENTIALS   = 'dockerhub-credentials'
        UAT_DH_CREDENTIALS  = 'dockerhub-credentials'
        PROD_DH_CREDENTIALS = 'dockerhub-credentials'
        AWS_REGION          = 'ap-south-1'
    }

    parameters{
        choice(
            name: 'Environment',
            choices: ["dev","qa","uat","prod"],
            description: "Select deployment environment"
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'provide commit id'
        )
    }

    stages{

        stage("build & push"){
            when {
                expression{
                    params.Environment == "dev"
                }
            }
            steps{
                script{
                    buildAndPushImage("${env.FRONTEND_IMAGE_DEV}","${env.DEV_DH_CREDENTIALS}", "${env.BUILD_CONTEXT}")
                }
            }
        }

        stage("Deploy DEV Frontend using Helm"){
            when {
                expression {
                    params.Environment == "dev"
                }
            }
            steps{
                script{
                    sh """
                        helm upgrade --install employee-management-frontend \
                        helm/employee-management \
                        -f helm/employee-management/values-dev.yaml \
                        --namespace employee-dev \
                        --create-namespace \
                        --set component=frontend \
                        --set frontend.image.repository=${env.FRONTEND_IMAGE_DEV} \
                        --set frontend.image.tag=${env.GIT_COMMIT}
                     """
                }
            }
        }

        stage("promote image DEV to QA"){
            when{
                expression{
                    params.Environment == "qa"
                }
            }
            steps{
                script{
                    promoteImage("${env.FRONTEND_IMAGE_DEV}","${env.FRONTEND_IMAGE_QA}","${env.DEV_DH_CREDENTIALS}","${env.QA_DH_CREDENTIALS}")
                }
            }
        }

        stage("Deploy QA Frontend using Helm"){
            when {
                expression {
                    params.Environment == "qa"
                }
            }
            steps{
                script{
                    sh """
                        helm upgrade --install employee-management-frontend \
                        helm/employee-management \
                        -f helm/employee-management/values-qa.yaml \
                        --namespace employee-qa \
                        --create-namespace \
                        --set component=frontend \
                        --set frontend.image.repository=${env.FRONTEND_IMAGE_QA} \
                        --set frontend.image.tag=${params.IMAGE_TAG}
                     """
                }
            }
        }

        stage("promote image QA to UAT"){
            when {
                expression{
                    params.Environment == "uat"
                }
            }
            steps{
                script{
                    promoteImage("${env.FRONTEND_IMAGE_QA}","${env.FRONTEND_IMAGE_UAT}","${env.QA_DH_CREDENTIALS}","${env.UAT_DH_CREDENTIALS}")
                }
            }
        }

        stage("Deploy UAT Frontend using Helm"){
            when {
                expression {
                    params.Environment == "uat"
                }
            }
            steps{
                script{
                    sh """
                        helm upgrade --install employee-management-frontend \
                        helm/employee-management \
                        -f helm/employee-management/values-uat.yaml \
                        --namespace employee-uat \
                        --create-namespace \
                        --set component=frontend \
                        --set frontend.image.repository=${env.FRONTEND_IMAGE_UAT} \
                        --set frontend.image.tag=${params.IMAGE_TAG}
                     """
                }
            }
        }

        stage("approval for prod"){
            when{
                expression{
                    params.Environment == 'prod'
                }
            }
            steps{
                input message: 'Promote the image from UAT to PROD?',
                      ok: "Promote to PROD"
            }
        }
        
        stage("Promote image from UAT to PROD"){
            when{
                expression{
                    params.Environment == "prod"
                }
            }
            steps{
                script{
                    promoteImage("${env.FRONTEND_IMAGE_UAT}","${env.FRONTEND_IMAGE_PROD}","${env.UAT_DH_CREDENTIALS}","${env.PROD_DH_CREDENTIALS}")
                }
            }
        }

        stage("Deploy PROD Frontend using Helm"){
            when {
                expression {
                    params.Environment == "prod"
                }
            }
            steps{
                script{
                    sh """
                        helm upgrade --install employee-management-frontend \
                        helm/employee-management \
                        -f helm/employee-management/values-prod.yaml \
                        --namespace employee-prod \
                        --create-namespace \
                        --set component=frontend \
                        --set frontend.image.repository=${env.FRONTEND_IMAGE_PROD} \
                        --set frontend.image.tag=${params.IMAGE_TAG}
                     """
                }
            }
        }
    }
    post{
        always{
            deleteDir()
        }
    }
}

def buildAndPushImage(String FRONTEND_IMAGE, String DH_CREDENTIALS, String Buildcontext){
    def frontend= docker.build("${FRONTEND_IMAGE}:${GIT_COMMIT}","${Buildcontext}")

    docker.withRegistry("${env.REGISTRY_URL}","${DH_CREDENTIALS}"){
        frontend.push()
    }
}

def promoteImage(String sourceImage, String targetImage, String source_DH_Credentials, String target_DH_Credentials){
    if (!params.IMAGE_TAG?.trim()) {
        error('IMAGE_TAG is required for image promotion.')
    }
    docker.withRegistry("${env.REGISTRY_URL}","${source_DH_Credentials}"){
        docker.image("${sourceImage}:${params.IMAGE_TAG}").pull()
    }

    sh "docker tag ${sourceImage}:${params.IMAGE_TAG} ${targetImage}:${params.IMAGE_TAG}"

    docker.withRegistry("${env.REGISTRY_URL}","${target_DH_Credentials}"){
        docker.image("${targetImage}:${params.IMAGE_TAG}").push()
    }
}