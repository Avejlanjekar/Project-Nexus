{
  "containerDefinitions": [
    {
      "name": "app4-backend",
      "image": "288497659312.dkr.ecr.ap-south-1.amazonaws.com/app4-backend-${ENV}:${COMMIT_ID}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "app4-backend-8000-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "PG_PASSWORD",
          "value": "mysecretpassword"
        },
        {
          "name": "RUST_LOG",
          "value": "debug"
        },
        {
          "name": "PG_USER",
          "value": "postgres"
        },
        {
          "name": "ADDRESS",
          "value": "0.0.0.0:8000"
        },
        {
          "name": "PG_DBNAME",
          "value": "postgres"
        },
        {
          "name": "PG_HOST",
          "value": "app4-db-${ENV}.app4.local"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app4-backend",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "app4-backend",
  "executionRoleArn": "arn:aws:iam::288497659312:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
