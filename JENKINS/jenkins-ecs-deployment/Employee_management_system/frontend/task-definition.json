{
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "916921211430.dkr.ecr.ap-south-1.amazonaws.com/app-frontend-${ENV}:${COMMIT_ID}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "BACKEND_HOST",
          "value": "backend.app-${ENV}.local"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app-frontend-${ENV}",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "frontend"
        }
      },
      "systemControls": []
    }
  ],
  "family": "app-frontend-${ENV}",
  "executionRoleArn": "arn:aws:iam::916921211430:role/app-ecs-task-execution-role-${ENV}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}