{
  "containerDefinitions": [
    {
      "name": "employee-frontend",
      "image": "288497659312.dkr.ecr.ap-south-1.amazonaws.com/employee-management-frontend-${ENV}:${COMMIT_ID}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "employee-frontend-80-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "BACKEND_HOST",
          "value": "employee-backend-${ENV}.employee.local"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/employee-management-frontend",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "employee-management-frontend",
  "executionRoleArn": "arn:aws:iam::288497659312:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}